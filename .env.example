# Base de données (Postgres — ex: Neon, chaîne "pooled connection")
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signe les sessions admin — longue valeur aléatoire, jamais la même en dev/prod
JWT_SECRET=change-moi-avec-une-longue-valeur-aleatoire

PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Cloudflare R2 (stockage des fichiers : logos, designs, photos clients, photos du site)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=n-vision-uploads

# Notifications email (optionnel — laisser vide pour désactiver)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
