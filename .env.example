# Copiez ce fichier en ".env" avant de lancer le serveur.

# Base de données (fichier local, créé automatiquement — pas de serveur à installer)
DATABASE_URL="file:./data/n_vision.db"

# Clé secrète pour sécuriser les connexions admin — mettez une longue phrase aléatoire
JWT_SECRET=change-moi-en-quelque-chose-de-long-et-aleatoire

PORT=4000

# Origine autorisée à appeler ce serveur (l'adresse du site en développement)
CORS_ORIGIN=http://localhost:5173

# --- Notifications par email (optionnel) ---
# Si vous laissez ces champs vides, les notifications sont simplement désactivées.
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=votre@gmail.com,
# SMTP_PASS=un "mot de passe d'application" Gmail (pas votre mot de passe normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse qui doit recevoir une notification à chaque nouvelle demande de devis
NOTIFY_EMAIL=
